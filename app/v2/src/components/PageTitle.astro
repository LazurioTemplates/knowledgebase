---
// The page title of Starlight, then the page's description as the line under
// it, then the page's other details in words: whether it is valid (a badge of
// the design system), who keeps it true, when it was last confirmed, other
// names, sources, and for a decision who made it, when and what replaced it.
// A page without them looks as Starlight draws it. Search indexes the
// description and the other names of a term (`Také`, `Also`), so that results
// show the text of a page, not the rest of its details.
import Default from "@astrojs/starlight/components/PageTitle.astro";
import Badge from "design-system/astro/Badge.astro";
import { describePage } from "../meta";

const route = Astro.locals.starlightRoute;
const { description } = route.entry.data;
const facts = describePage(route.entry.data, route.lang, (id) => `/${id}/`);
---

<Default />
{description && <p class="kb-description">{description}</p>}
{
  facts.length > 0 && (
    <p class="kb-meta">
      {facts.map((fact) => (
        <>
          <span class="kb-meta__fact" data-pagefind-ignore={fact.indexed ? undefined : true}>
            {fact.label}:{" "}
            {fact.tone ? (
              <Badge tone={fact.tone}>{fact.value}</Badge>
            ) : fact.parts ? (
              fact.parts.map((part, i) => (
                <>
                  {i > 0 && "; "}
                  {part.href ? <a href={part.href}>{part.text}</a> : part.text}
                </>
              ))
            ) : fact.href ? (
              <a href={fact.href}>{fact.value}</a>
            ) : (
              fact.value
            )}
          </span>{" "}
        </>
      ))}
    </p>
  )
}
